# Copie ce fichier en ".env" puis remplis les valeurs. Ne commite JAMAIS le vrai .env.
# Azure : endpoint de ta ressource + "openai/v1/" a la fin
LLM_BASE_URL=https://TON-RESOURCE.openai.azure.com/openai/v1/
LLM_API_KEY=ta-cle-ici
# Azure : le NOM DU DEPLOIEMENT (ex: gpt-5-mini)
LLM_MODEL=gpt-5-mini
